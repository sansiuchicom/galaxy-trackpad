{
    "touchpad": {
        "cursor_sensitivity": 1.0,
        "scroll_sensitivity": 1.0,
        "pinch_sensitivity": 1.0,
        "touch_feedback": true,
        "input_area": "fullscreen",
        "keypad": {
            "pages": [
                {
                    "symbols": [
                        ",", "…", "⋮", "·",
                        "✓", "✔", "☐", "☑",
                        "←", "→", "↑", "↓",
                        "⇒", "⇔", "※", "★",
                        "○", "●", "▲", "▼"
                    ]
                },
                {
                    "symbols": [
                        "₩", "€", "$", "¥",
                        "½", "¼", "¾", "π",
                        "©", "®", "™", "§",
                        "•", "†", "‡", "°",
                        "℃", "µ", "Ω", "∞"
                    ]
                }
            ]
        }
    },
    "pen": {
        "active_profile": "standard",
        "tablet_aspect": 1.6,
        "profiles": {
            "standard": {
                "monitor_id": "primary",
                "mapping": "stretch",
                "area_size": 1.0
            },
            "drawing": {
                "monitor_id": "primary",
                "mapping": "preserve_aspect_ratio",
                "area_size": 1.0,
                "region": null
            }
        }
    },
    "general": {
        "start_with_windows": true,
        "auto_start_engine": true,
        "debug_log": false
    }
}
